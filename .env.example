# Supabase Configuration
# Found at: https://supabase.com/dashboard/project/_/settings/api
#
# Forgot-password: Dashboard → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/auth/reset-password
#   https://YOUR_PRODUCTION_DOMAIN/auth/reset-password
#
# Google OAuth (Popup + redirect): add the SAME paths for Site URL redirects, e.g.:
#   http://localhost:3000/auth/callback
#   https://YOUR_PRODUCTION_DOMAIN/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (subscriptions — Checkout + webhooks)
# API keys: https://dashboard.stripe.com/apikeys  (use sk_test_ / pk_test_ in development)
# Price IDs: Dashboard → Product catalog → each price → API ID (price_...)
# Webhook signing secret: Developers → Webhooks → Add endpoint → Signing secret (whsec_...)
#   Local dev: install Stripe CLI and run: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_YEARLY=

# PayPal Configuration
# Found at: https://developer.paypal.com/dashboard/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI Configuration (Google Gemini)
# Found at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SMTP Configuration (Optional for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=homeonline23@gmail.com
SMTP_PASS=
SMTP_FROM=The Oracle <homeonline23@gmail.com>

# App Configuration
# Public URL for the navbar "Site" button (new tab / iPhone testing)
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security & Admin Setup
ADMIN_SETUP_KEY=
NEXT_PUBLIC_ADMIN_BYPASS_KEY=
NEXT_PUBLIC_ADMIN_EMAIL=homeonline23@gmail.com

# Namecheap Deployment (Safe Upload)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
