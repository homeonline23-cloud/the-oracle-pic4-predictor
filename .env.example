# Supabase Configuration
# Found at: https://supabase.com/dashboard/project/_/settings/api
#
# Forgot-password: Dashboard → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/auth/reset-password
#   https://YOUR_PRODUCTION_DOMAIN/auth/reset-password
#
# Google OAuth (Popup + redirect): add the SAME paths for Site URL redirects, e.g.:
# Site URL for OAuth redirects (production):
#   NEXT_PUBLIC_APP_URL=https://theoraclepic4.com
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://www.theoraclepic4.com
#   Redirect URLs (add both www and non-www):
#     https://www.theoraclepic4.com/auth/callback
#     https://theoraclepic4.com/auth/callback
#     http://localhost:3002/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (subscriptions — Checkout + webhooks)
# API keys: https://dashboard.stripe.com/apikeys  (use sk_test_ / pk_test_ in development)
# Price IDs: Dashboard → Product catalog → each price → API ID (price_...)
# Webhook signing secret: Developers → Webhooks → Add endpoint → Signing secret (whsec_...)
#   Local dev: install Stripe CLI and run: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_YEARLY=

# PayPal Configuration
# Found at: https://developer.paypal.com/dashboard/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI Configuration (Google Gemini)
# Found at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SMTP Configuration (Optional for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=homeonline23@gmail.com
SMTP_PASS=
SMTP_FROM=The Oracle <homeonline23@gmail.com>

# Public URL for production OAuth redirects (Vercel). Leave unset for local dev —
# localhost:3002 is detected automatically and will NOT redirect to live.
# NEXT_PUBLIC_APP_URL=https://theoraclepic4.com

# Google Analytics 4 (gtag.js) — loaded on every page in production
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R831CB5X7N

# Google AdSense (Auto ads — script in site head)
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-2181194415627859

# Optional Google Tag Manager (leave empty if using GA only)
NEXT_PUBLIC_GTM_ID=

SUPABASE_SERVICE_ROLE_KEY=

# Public 4-grid tester demo (share in ads/Fiverr): /demo/grid2
NEXT_PUBLIC_GRID2_DEMO_EMAIL=try-grid2@theoraclepic4.com
GRID2_DEMO_PASSWORD=
NEXT_PUBLIC_GRID2_DEMO_ENABLED=true

# Owner demo login (server-only — never use NEXT_PUBLIC_* for passwords)
DEMO_EMAIL=
DEMO_PASSWORD=

# Security & Admin Setup (set on Vercel — not shown on the website)
ADMIN_EMAIL=
ADMIN_SETUP_KEY=
NEXT_PUBLIC_ADMIN_EMAIL=

# Namecheap Deployment (Safe Upload)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
